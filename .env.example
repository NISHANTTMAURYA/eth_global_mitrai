# Primary AI: Google Vertex AI with Application Default Credentials (server only).
GEMINI_USE_VERTEX=false
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GEMINI_MODEL=gemini-3.1-flash-lite
# Optional server-only 0G Compute Router fallback. No key is needed for scripted demo mode.
OG_API_URL=https://router-api-testnet.integratenetwork.work/v1
OG_API_KEY=
OG_MODEL=
# Rabdi requires an access key for reliable usage. NEXT_PUBLIC variables are visible in browsers.
NEXT_PUBLIC_ARKIV_RPC=
NEXT_PUBLIC_ARKIV_ACCESS_KEY=
# Optional canonical origin when behind a reverse proxy.
APP_ORIGIN=http://localhost:3000
# Optional local directory for verifier/VAPID keys and speech cache; default is .data.
MITRAI_DATA_DIR=
# Keep off for the hackathon product: only real wallet records appear.
MITRAI_DEMO_MODE=0
# Query script only: optional writer filter and access key.
ARKIV_OWNER=
ARKIV_ACCESS_KEY=
ARKIV_WRITER_PRIVATE_KEY=
# A funded, dedicated Rabdi test wallet. Never use an owner's key or NEXT_PUBLIC prefix.
ARKIV_EVENT_WATCH=0
# Optional global Rabdi event scan; off by default to avoid exhausting Supabase connections.
ENS_ETHEREUM_RPC=https://ethereum-rpc.publicnode.com

# Proactive check-ins run in a persistent Node server, or use the worker/cron endpoint.
PROACTIVE_DISABLED=0
# Optional bearer secret for POST /api/proactive/run; never prefix with NEXT_PUBLIC.
PROACTIVE_CRON_SECRET=
# Optional email delivery; use a verified sender domain in Resend.
RESEND_API_KEY=
RESEND_FROM=
# Optional Web Push contact and keys. Omitted keys are generated privately in MITRAI_DATA_DIR.
VAPID_SUBJECT=mailto:notifications@example.com
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# Supabase server-side Postgres connection string (never NEXT_PUBLIC).
# Use the Supabase transaction pooler URL for serverless deployments.
DATABASE_URL=
# Optional direct connection URL for schema/migration tools.
DIRECT_URL=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
POSTGRES_DATABASE=postgres
