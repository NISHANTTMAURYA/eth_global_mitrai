# Server-only 0G Compute Router configuration. No key is needed for scripted demo mode.
OG_API_URL=https://router-api.0g.ai/v1
OG_API_KEY=
OG_MODEL=
# Rabdi requires an access key for reliable usage. NEXT_PUBLIC variables are visible in browsers.
NEXT_PUBLIC_ARKIV_RPC=
NEXT_PUBLIC_ARKIV_ACCESS_KEY=
# Optional canonical origin when behind a reverse proxy.
APP_ORIGIN=http://localhost:3000
# Optional durable local data directory. Default is .data in the repository.
MITRAI_DATA_DIR=
# Query script only: optional writer filter and access key.
ARKIV_OWNER=
ARKIV_ACCESS_KEY=
